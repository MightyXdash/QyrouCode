{
  "name": "suprarcode",
  "version": "0.0.1",
  "private": true,
  "description": "Local coding model runner",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit",
    "test:settings": "tsc -p tsconfig.settings-test.json && node --test .test-dist/tests/settings.test.js",
    "test:runtime": "tsc -p tsconfig.settings-test.json && node --test .test-dist/tests/llama.test.js .test-dist/tests/localCompletionClient.test.js .test-dist/tests/modelManifest.test.js .test-dist/tests/modelResolver.test.js .test-dist/tests/runtimePaths.test.js .test-dist/tests/runtimeManifest.test.js",
    "bootstrap:runtime": "tsc -p tsconfig.settings-test.json && node .test-dist/scripts/bootstrapLlamaRuntime.js"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.supracode.app",
    "productName": "SupraCode",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "vendor/llama.cpp/linux-x64",
          "to": "llama.cpp/linux-x64"
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
