{
  "name": "qyroucode",
  "version": "0.0.1",
  "private": true,
  "description": "Local coding model runner",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit",
    "test:settings": "tsc -p tsconfig.settings-test.json && node --test .test-dist/tests/settings.test.js .test-dist/tests/connections.test.js .test-dist/tests/remoteModels.test.js .test-dist/tests/conversationExport.test.js .test-dist/tests/browser.test.js",
    "test:runtime": "tsc -p tsconfig.settings-test.json && node --test .test-dist/tests/agentRuntime.test.js .test-dist/tests/agentTools.test.js .test-dist/tests/workLog.test.js .test-dist/tests/fileViewer.test.js .test-dist/tests/gguf.test.js .test-dist/tests/connections.test.js .test-dist/tests/llama.test.js .test-dist/tests/localCompletionClient.test.js .test-dist/tests/remoteCompletionClient.test.js .test-dist/tests/modelManifest.test.js .test-dist/tests/modelProjector.test.js .test-dist/tests/modelResolver.test.js .test-dist/tests/promptRefiner.test.js .test-dist/tests/reasoningProfiles.test.js .test-dist/tests/remoteModels.test.js .test-dist/tests/runtimePaths.test.js .test-dist/tests/runtimeManifest.test.js .test-dist/tests/terminalTranscript.test.js .test-dist/tests/toolCallParser.test.js .test-dist/tests/webSearch.test.js",
    "bootstrap:runtime": "tsc -p tsconfig.settings-test.json && node .test-dist/scripts/bootstrapLlamaRuntime.js --backend cuda",
    "bootstrap:runtime:cpu": "npm run bootstrap:runtime -- --backend cpu",
    "bootstrap:runtime:vulkan": "npm run bootstrap:runtime -- --backend vulkan",
    "verify:vision": "tsc -p tsconfig.settings-test.json && node .test-dist/scripts/verifyVisionModels.js"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-store": "^10.0.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "read-excel-file": "^9.3.5",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.qyroucode.app",
    "productName": "QyrouCode",
    "afterPack": "scripts/afterPack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icons/icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icons/icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "vendor/llama.cpp",
          "to": "llama.cpp",
          "filter": [
            "win32-x64-*/**/*"
          ]
        }
      ],
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "vendor/llama.cpp",
          "to": "llama.cpp",
          "filter": [
            "linux-x64-*/**/*"
          ]
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
